---
import Aplikasi from '../../layouts/Aplikasi.astro';
import Keadaan from '../../components/Keadaan.astro';
import Kartu from '../../components/Kartu.astro';
---

<Aplikasi judul="Dashboard Admin" sub="Ringkasan versi profil yang dipakai untuk rekomendasi.">
  <div class="halaman" id="halaman">
    <Keadaan memuat="Memuat ringkasan">
      <Fragment slot="galat-aksi"><button class="tombol tombol--sekunder" type="button" id="ulang">Coba lagi</button></Fragment>
      <Fragment slot="kosong">
        <p>Belum ada versi profil. Unggah dataset survei untuk membuat yang pertama.</p>
        <div class="baris"><a class="tombol" href="/kelola/unggah/">Unggah Dataset</a></div>
      </Fragment>
    </Keadaan>

    <div data-keadaan="siap" class="halaman" hidden>
      <div id="stat"></div>

      <Kartu judul="Pintasan">
        <div class="baris">
          <a class="tombol" href="/kelola/unggah/">Unggah Dataset</a>
          <a class="tombol tombol--sekunder" href="/kelola/versi/">Versi Profil</a>
          <a class="tombol tombol--sekunder" href="/rekomendasi/">Pilih Teknologi</a>
        </div>
      </Kartu>

      <Kartu judul="Riwayat Unggahan Dataset" sub="Tiga unggahan paling baru." nol>
        <a slot="aksi" class="tombol tombol--sekunder tombol--kecil" href="/kelola/versi/">Lihat semua</a>
        <div class="gulir" role="region" aria-label="Tabel versi terbaru" tabindex="0">
          <table>
            <thead>
              <tr>
                <th scope="col">ID</th>
                <th scope="col">Berkas</th>
                <th scope="col">Dibuat</th>
                <th scope="col" class="angka">Developer</th>
                <th scope="col">Status</th>
                <th scope="col"><span class="sr-saja">Aksi</span></th>
              </tr>
            </thead>
            <tbody id="terbaru"></tbody>
          </table>
        </div>
      </Kartu>
    </div>
  </div>

  <script>
    import { api } from '../../lib/api';
    import { wajibMasuk } from '../../lib/auth';
    import { macroHit3 } from '../../lib/versi';
    import { $, angka, el, persen, pilStatus, tampilkan, tanggal } from '../../lib/ui';
    import type { VersiDetail, VersiRingkas } from '../../lib/types';

    const halaman = $('#halaman');

    function stat(label: string, nilai: string, ket: string, opsi: { utama?: boolean; teks?: boolean } = {}) {
      return el(
        'div',
        { class: opsi.utama ? 'kartu kartu--utama stat' : 'kartu stat' },
        el('span', { class: 'stat__label' }, label),
        el('span', { class: opsi.teks ? 'stat__nilai stat__nilai--teks' : 'stat__nilai' }, nilai),
        el('span', { class: 'stat__ket' }, ket),
      );
    }

    async function muat() {
      tampilkan(halaman, 'memuat');
      try {
        const daftar = await api<VersiRingkas[]>('/admin/profile-versions');
        if (daftar.length === 0) return tampilkan(halaman, 'kosong');

        const aktif = daftar.find((v) => v.is_active);
        const detail = aktif ? await api<VersiDetail>(`/admin/profile-versions/${aktif.id}`) : null;
        const kotakStat = $('#stat');
        if (aktif) {
          const h = macroHit3(aktif);
          kotakStat.replaceChildren(
            el(
              'div',
              { class: 'grid-stat' },
              stat('Versi Profil Aktif', aktif.filename, `Versi ${aktif.id}, dibuat ${tanggal(aktif.created_at)}`, { utama: true, teks: true }),
              stat('Developer', aktif.n_developer === null ? '-' : angka(aktif.n_developer), 'dalam profil'),
              stat('Teknologi', detail?.ringkasan ? angka(detail.ringkasan.n_teknologi) : '-', 'dikenali sistem'),
              stat('Macro-Hit@3', h === null ? '-' : persen(h), 'dengan 3 teknologi dipilih'),
            ),
          );
        } else {
          kotakStat.replaceChildren(
            el('p', { class: 'pesan pesan--info' }, 'Belum ada versi yang aktif, jadi Mahasiswa belum bisa meminta rekomendasi. Aktifkan salah satu versi di halaman Versi Profil.'),
          );
        }

        $('#terbaru').replaceChildren(
          ...daftar.slice(0, 3).map((v) =>
            el(
              'tr',
              {},
              el('td', { class: 'mono' }, `#${v.id}`),
              el('td', {}, v.filename),
              el('td', {}, tanggal(v.created_at)),
              el('td', { class: 'angka' }, v.n_developer === null ? '-' : angka(v.n_developer)),
              el('td', {}, pilStatus(v.status, v.is_active)),
              el('td', { class: 'angka' }, el('a', { href: `/kelola/versi/detail/?id=${v.id}` }, 'Detail')),
            ),
          ),
        );
        tampilkan(halaman, 'siap');
      } catch (err) {
        $('[data-pesan-galat]', halaman).textContent = err instanceof Error ? err.message : 'Terjadi kesalahan.';
        tampilkan(halaman, 'galat');
      }
    }

    $('#ulang').addEventListener('click', muat);
    if (wajibMasuk('admin')) muat();
  </script>
</Aplikasi>

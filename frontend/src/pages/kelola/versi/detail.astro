---
import Aplikasi from '../../../layouts/Aplikasi.astro';
import Keadaan from '../../../components/Keadaan.astro';
import Kartu from '../../../components/Kartu.astro';
---

<Aplikasi judul="Detail Versi Profil">
  <Fragment slot="aksi-tajuk">
    <a class="tombol tombol--sekunder" href="/kelola/versi/">Kembali ke Versi Profil</a>
    <button class="tombol" type="button" id="aktifkan" hidden>Jadikan Aktif</button>
    <button class="tombol tombol--sekunder" type="button" id="nonaktifkan" hidden>Nonaktifkan</button>
    <button class="tombol tombol--hapus" type="button" id="hapus" hidden>Hapus Versi</button>
  </Fragment>

  <div class="halaman" id="halaman">
    <Keadaan memuat="Memuat detail versi">
      <a slot="galat-aksi" class="tombol tombol--sekunder" href="/kelola/versi/">Ke daftar versi</a>
      <Fragment slot="kosong"><p>Versi ini belum punya ringkasan.</p></Fragment>
    </Keadaan>

    <div data-keadaan="siap" class="halaman" hidden>
      <div class="baris"><span id="status"></span><p class="kecil" id="info"></p></div>
      <p class="pesan pesan--galat" id="error" hidden></p>
      <p class="pesan pesan--galat" id="galat-aksi" role="alert" hidden></p>

      <Kartu judul="Penyaringan data" sub="Tahap yang dilalui dataset sebelum profil dibentuk." nol>
        <div class="gulir" role="region" aria-label="Tabel penyaringan" tabindex="0">
          <table>
            <thead><tr><th scope="col">Tahap</th><th scope="col">Alasan</th><th scope="col" class="angka">Sisa</th><th scope="col" class="angka">Terbuang</th></tr></thead>
            <tbody id="saring"></tbody>
          </table>
        </div>
      </Kartu>

      <Kartu judul="Developer per bidang" nol>
        <div class="gulir" role="region" aria-label="Tabel developer per bidang" tabindex="0">
          <table>
            <thead><tr><th scope="col">Bidang</th><th scope="col" class="angka">Semua</th><th scope="col" class="angka">Awal karier</th></tr></thead>
            <tbody id="bidang"></tbody>
          </table>
        </div>
      </Kartu>

      <Kartu judul="Evaluasi" sub="Hit@3 menurut jumlah teknologi yang dipilih, dibandingkan dengan bidang terbanyak." nol>
        <div class="gulir" role="region" aria-label="Tabel evaluasi" tabindex="0">
          <table>
            <thead><tr><th scope="col">Jumlah teknologi</th><th scope="col" class="angka">Data uji</th><th scope="col" class="angka">Hit@3</th><th scope="col" class="angka">macro-Hit@3</th></tr></thead>
            <tbody id="evaluasi"></tbody>
          </table>
        </div>
      </Kartu>

      <Kartu judul="Parameter dan alasannya" nol>
        <div class="gulir" role="region" aria-label="Tabel parameter" tabindex="0">
          <table>
            <thead><tr><th scope="col">Parameter</th><th scope="col">Nilai</th><th scope="col">Sumber</th><th scope="col">Alasan</th></tr></thead>
            <tbody id="param"></tbody>
          </table>
        </div>
      </Kartu>
    </div>
  </div>

  <script>
    import { api } from '../../../lib/api';
    import { wajibMasuk } from '../../../lib/auth';
    import { aktifkanVersi, bisaDihapus, hapusVersi, nonaktifkanVersi } from '../../../lib/versi';
    import { $, angka, el, parameterUrl, pilStatus, tampilkan } from '../../../lib/ui';
    import type { VersiDetail } from '../../../lib/types';

    const halaman = $('#halaman');
    const tombolAktif = $<HTMLButtonElement>('#aktifkan');
    const tombolNonaktif = $<HTMLButtonElement>('#nonaktifkan');
    const tombolHapus = $<HTMLButtonElement>('#hapus');
    const galatAksi = $('#galat-aksi');
    let jadwal: number | undefined;

    function galat(teks: string) {
      $('[data-pesan-galat]', halaman).textContent = teks;
      tampilkan(halaman, 'galat');
    }
    const sel = (...isi: (string | number)[]) => isi.map((x) => el('td', typeof x === 'number' ? { class: 'angka' } : {}, typeof x === 'number' ? angka(x) : x));
    const nilai = (v: unknown) => (Array.isArray(v) ? v.join(', ') : typeof v === 'object' && v ? JSON.stringify(v) : String(v));

    /** Jalankan satu aksi; bila jadi dilakukan (tidak dibatalkan di dialog), lanjut ke `sesudah`. */
    async function coba(aksi: () => Promise<boolean>, sesudah: () => unknown) {
      galatAksi.hidden = true;
      try {
        if (await aksi()) await sesudah();
      } catch (err) {
        galatAksi.textContent = err instanceof Error ? err.message : 'Terjadi kesalahan.';
        galatAksi.hidden = false;
      }
    }

    async function muat(id: number) {
      window.clearTimeout(jadwal);
      try {
        const v = await api<VersiDetail>(`/admin/profile-versions/${id}`);
        const sub = $('#sub-halaman');
        sub.textContent = `Versi ${v.id}: ${v.filename}`;
        sub.hidden = false;
        $('#status').replaceChildren(pilStatus(v.status, v.is_active));
        $('#info').textContent = v.status === 'processing' ? 'Sedang diproses, halaman diperbarui otomatis.' : '';
        const error = $('#error');
        error.hidden = !v.error;
        error.textContent = v.error ?? '';
        tombolAktif.hidden = !(v.status === 'ready' && !v.is_active);
        tombolAktif.onclick = () => coba(async () => (await aktifkanVersi(v.id), true), () => muat(id));
        tombolNonaktif.hidden = !v.is_active;
        tombolNonaktif.onclick = () => coba(() => nonaktifkanVersi(v), () => muat(id));
        tombolHapus.hidden = !bisaDihapus(v);
        tombolHapus.onclick = () => coba(() => hapusVersi(v), () => location.assign(`/kelola/versi/?dihapus=${v.id}`));

        if (v.status === 'processing') {
          tampilkan(halaman, 'siap');
          jadwal = window.setTimeout(() => muat(id), 4000);
        }
        const r = v.ringkasan;
        if (!r) return v.status === 'processing' ? undefined : tampilkan(halaman, 'kosong');

        $('#saring').replaceChildren(...r.penyaringan.map((p) => el('tr', {}, ...sel(p.tahap, p.alasan, p.sisa, p.terbuang))));
        $('#bidang').replaceChildren(...r.per_bidang.map((b) => el('tr', {}, ...sel(b.bidang, b.semua, b.awal_karier))));
        const k = r.params.top_k;
        const evaluasi = r.metrik.skenario.map((s) => el('tr', {}, ...sel(String(s.teknologi), s.n_uji, Number(s[`Hit@${k}`]), Number(s[`macro-Hit@${k}`]))));
        const b = r.metrik.baseline_popularitas;
        evaluasi.push(el('tr', {}, ...sel('Pembanding: bidang terbanyak', r.metrik.n_uji, Number(b[`Hit@${k}`]), Number(b[`macro-Hit@${k}`]))));
        $('#evaluasi').replaceChildren(...evaluasi);
        $('#param').replaceChildren(...r.params.penjelasan.map((p) => el('tr', {}, ...sel(p.parameter, nilai(p.nilai), p.sumber, p.alasan))));
        tampilkan(halaman, 'siap');
      } catch (err) {
        galat(err instanceof Error ? err.message : 'Terjadi kesalahan.');
      }
    }

    if (wajibMasuk('admin')) {
      const id = Number(parameterUrl('id'));
      if (!Number.isInteger(id) || id <= 0) galat('Alamat ini tidak memuat nomor versi yang valid.');
      else muat(id);
    }
  </script>
</Aplikasi>

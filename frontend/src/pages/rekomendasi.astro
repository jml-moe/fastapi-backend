---
import Base from '../layouts/Base.astro';
import Keadaan from '../components/Keadaan.astro';
---

<Base judul="Pilih teknologi">
  <div class="tumpukan" id="halaman">
    <div class="tumpukan--rapat">
      <h1>Pilih teknologi yang pernah Anda pakai</h1>
      <p class="sub">Centang minimal tiga. Semakin lengkap pilihan Anda, semakin tajam perbandingannya.</p>
    </div>

    <Keadaan memuat="Memuat daftar teknologi">
      <a slot="galat-aksi" class="tombol tombol--sekunder" href="/kelola/" id="ke-kelola" hidden>Buka kelola dataset</a>
      <Fragment slot="kosong">
        <p>Belum ada teknologi yang bisa dipilih.</p>
      </Fragment>
    </Keadaan>

    <form id="form" data-keadaan="siap" class="tumpukan" hidden>
      <div class="bidang">
        <label for="cari">Cari teknologi</label>
        <input id="cari" type="search" autocomplete="off" aria-controls="kelompok" />
      </div>
      <div id="kelompok" class="tumpukan"></div>
      <p class="kosong" id="tak-ada" hidden>Tidak ada teknologi yang cocok dengan pencarian.</p>
      <div class="bilah-bawah">
        <p id="hitung" role="status" aria-live="polite"></p>
        <p class="pesan pesan--galat" id="galat-kirim" role="alert" hidden></p>
        <button class="tombol" type="submit" id="kirim" disabled>Lihat rekomendasi</button>
      </div>
    </form>
  </div>

  <script>
    import { api, ApiError } from '../lib/api';
    import { wajibMasuk } from '../lib/auth';
    import { MIN_TEKNOLOGI } from '../lib/config';
    import { ambilPeran } from '../lib/sesi';
    import { $, el, tampilkan } from '../lib/ui';
    import type { DaftarTeknologi, Rekomendasi } from '../lib/types';


    const halaman = $('#halaman');
    const form = $<HTMLFormElement>('#form');
    const kelompok = $('#kelompok');
    const cari = $<HTMLInputElement>('#cari');
    const takAda = $('#tak-ada');
    const hitung = $('#hitung');
    const kirim = $<HTMLButtonElement>('#kirim');
    const galatKirim = $('#galat-kirim');

    const kotak = () => Array.from(kelompok.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));
    const terpilih = () => kotak().filter((k) => k.checked).map((k) => k.value);

    function perbaruiHitungan() {
      const n = terpilih().length;
      const kurang = MIN_TEKNOLOGI - n;
      hitung.textContent =
        kurang > 0
          ? `${n} dipilih. Pilih ${kurang} lagi untuk melanjutkan.`
          : `${n} teknologi dipilih.`;
      kirim.disabled = kurang > 0;
    }

    function saring() {
      const kata = cari.value.trim().toLowerCase();
      let tampil = 0;
      for (const label of kelompok.querySelectorAll<HTMLLabelElement>('.pilihan__item')) {
        const input = label.querySelector('input')!;
        const cocok = !kata || (label.textContent ?? '').toLowerCase().includes(kata) || input.checked;
        label.hidden = !cocok;
        if (cocok) tampil++;
      }
      for (const set of kelompok.querySelectorAll<HTMLElement>('fieldset')) {
        set.hidden = !set.querySelector('.pilihan__item:not([hidden])');
      }
      takAda.hidden = tampil > 0;
    }

    function gambar(data: DaftarTeknologi) {
      let ada = 0;
      for (const [nama, daftar] of Object.entries(data)) {
        if (daftar.length === 0) continue;
        ada += daftar.length;
        const isi = el('div', { class: 'pilihan' });
        for (const t of daftar) {
          isi.append(
            el('label', { class: 'pilihan__item' }, el('input', { type: 'checkbox', value: t.kode, name: 'teknologi' }), t.nama),
          );
        }
        kelompok.append(el('fieldset', { class: 'kelompok' }, el('legend', {}, `${nama} (${daftar.length})`), isi));
      }
      return ada;
    }

    async function muat() {
      tampilkan(halaman, 'memuat');
      try {
        const data = await api<DaftarTeknologi>('/technologies');
        if (gambar(data) === 0) return tampilkan(halaman, 'kosong');
        perbaruiHitungan();
        tampilkan(halaman, 'siap');
      } catch (err) {
        $('[data-pesan-galat]', halaman).textContent = err instanceof Error ? err.message : 'Terjadi kesalahan.';
        $('#ke-kelola').hidden = !(err instanceof ApiError && err.status === 503 && ambilPeran() === 'admin');
        tampilkan(halaman, 'galat');
      }
    }

    form.addEventListener('change', () => {
      perbaruiHitungan();
      saring();
    });
    cari.addEventListener('input', saring);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      galatKirim.hidden = true;
      kirim.disabled = true;
      kirim.textContent = 'Menghitung';
      try {
        const r = await api<Rekomendasi>('/recommendations', { json: { teknologi: terpilih() } });
        location.assign(`/hasil/?id=${r.id}`);
      } catch (err) {
        galatKirim.textContent = err instanceof Error ? err.message : 'Terjadi kesalahan.';
        galatKirim.hidden = false;
        kirim.textContent = 'Lihat rekomendasi';
        perbaruiHitungan();
      }
    });

    if (wajibMasuk()) muat();
  </script>
</Base>

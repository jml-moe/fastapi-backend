---
import Base from '../layouts/Base.astro';
---

<Base judul="Masuk" lebar="sempit">
  <div class="tumpukan">
    <h1>Masuk</h1>
    <form id="form" class="kartu tumpukan" novalidate>
      <div class="bidang">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="bidang">
        <label for="password">Kata sandi</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <p class="pesan pesan--galat" id="galat" role="alert" hidden></p>
      <button class="tombol" type="submit" id="kirim">Masuk</button>
    </form>
    <p>Belum punya akun? <a href="/daftar/">Buat akun</a></p>
  </div>

  <script>
    import { masuk } from '../lib/auth';
    import { ApiError } from '../lib/api';
    import { $, parameterUrl } from '../lib/ui';

    const form = $<HTMLFormElement>('#form');
    const galat = $('#galat');
    const kirim = $<HTMLButtonElement>('#kirim');

    // Hanya jalur di situs sendiri yang boleh dijadikan tujuan setelah masuk.
    function tujuan(peran: string): string {
      const lanjut = parameterUrl('lanjut');
      if (lanjut && lanjut.startsWith('/') && !lanjut.startsWith('//')) return lanjut;
      return peran === 'admin' ? '/kelola/' : '/rekomendasi/';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      galat.hidden = true;
      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');
      if (!email || !password) {
        galat.textContent = 'Isi email dan kata sandi.';
        galat.hidden = false;
        return;
      }
      kirim.disabled = true;
      kirim.textContent = 'Memeriksa';
      try {
        location.assign(tujuan(await masuk(email, password)));
      } catch (err) {
        galat.textContent =
          err instanceof ApiError && err.status === 401
            ? 'Email atau kata sandi salah.'
            : err instanceof Error
              ? err.message
              : 'Terjadi kesalahan.';
        galat.hidden = false;
        kirim.disabled = false;
        kirim.textContent = 'Masuk';
      }
    });
  </script>
</Base>

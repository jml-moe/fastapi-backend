---
import Aplikasi from '../../layouts/Aplikasi.astro';
import Keadaan from '../../components/Keadaan.astro';
import Kartu from '../../components/Kartu.astro';
---

<Aplikasi judul="Detail Rekomendasi">
  <a slot="aksi-tajuk" class="tombol tombol--sekunder" href="/riwayat/" id="kembali">Kembali ke Hasil Rekomendasi</a>

  <div class="halaman" id="halaman">
    <Keadaan memuat="Memuat detail">
      <a slot="galat-aksi" class="tombol tombol--sekunder" href="/riwayat/">Lihat riwayat</a>
      <Fragment slot="kosong"><p>Rekomendasi ini tidak memuat bidang apa pun.</p></Fragment>
    </Keadaan>

    <div data-keadaan="siap" class="halaman" hidden>
      <section class="kartu kartu--utama">
        <header class="kartu__kepala">
          <div>
            <h2 id="bidang"></h2>
            <p>Skor kemiripan</p>
          </div>
          <span class="skor skor--besar" id="skor"></span>
        </header>
      </section>

      <div class="grid-dua">
        <Kartu judul="Dasar perhitungan skor" sub="Sumbangan setiap teknologi yang Anda pilih terhadap skor bidang ini.">
          <ul class="sumbangan" id="sumbangan"></ul>
          <p class="kecil kaki-kartu">Sumbangan adalah bagian skor yang berasal dari teknologi yang Anda pilih; jumlahnya 100%.</p>
        </Kartu>
        <Kartu judul="Paling banyak dipakai di bidang" sub="Proporsi developer di bidang ini yang memakai teknologi tersebut.">
          <ul class="umum" id="umum"></ul>
          <p class="kecil kaki-kartu">Daftar ini bersifat deskriptif, bukan teknologi yang dibutuhkan bidang ini.</p>
        </Kartu>
      </div>
    </div>
  </div>

  <script>
    import { api } from '../../lib/api';
    import { wajibMasuk } from '../../lib/auth';
    import { $, angka, el, namaTeknologi, parameterUrl, persen, tampilkan } from '../../lib/ui';
    import type { Rekomendasi } from '../../lib/types';

    const halaman = $('#halaman');

    function galat(teks: string) {
      $('[data-pesan-galat]', halaman).textContent = teks;
      tampilkan(halaman, 'galat');
    }

    async function muat() {
      const id = Number(parameterUrl('id'));
      const urutan = Number(parameterUrl('peringkat'));
      if (!Number.isInteger(id) || id <= 0 || !Number.isInteger(urutan) || urutan <= 0) {
        return galat('Alamat ini tidak memuat nomor rekomendasi dan peringkat yang valid.');
      }
      $<HTMLAnchorElement>('#kembali').href = `/hasil/?id=${id}`;
      try {
        const r = await api<Rekomendasi>(`/recommendations/${id}`);
        const p = r.peringkat.find((x) => x.peringkat === urutan);
        if (!p) return galat('Bidang dengan peringkat itu tidak ada pada rekomendasi ini.');
        if (!p.sumbangan || !p.teknologi_umum) return galat('Detail hanya tersedia untuk tiga bidang teratas.');

        const sub = $('#sub-halaman');
        sub.textContent = `Peringkat ${p.peringkat} dari ${r.peringkat.length} bidang karier`;
        sub.hidden = false;
        $('#bidang').textContent = p.bidang_karier;
        $('#skor').textContent = angka(p.skor);

        $('#sumbangan').replaceChildren(
          ...p.sumbangan.map((s) => {
            const meter = el('meter', { min: '0', max: '1', value: String(s.sumbangan), 'aria-label': `Sumbangan ${namaTeknologi(s.kode)}` });
            meter.textContent = persen(s.sumbangan);
            return el('li', {}, el('span', {}, namaTeknologi(s.kode)), meter, el('span', { class: 'skor' }, persen(s.sumbangan)));
          }),
        );
        $('#umum').replaceChildren(
          ...p.teknologi_umum.map((u) =>
            el('li', {}, el('span', {}, namaTeknologi(u.kode)), el('span', { class: 'skor' }, persen(u.proporsi)), u.dipilih ? el('span', { class: 'pil' }, 'Dipilih') : el('span', { class: 'sr-saja' }, 'Tidak dipilih')),
          ),
        );
        tampilkan(halaman, 'siap');
      } catch (err) {
        galat(err instanceof Error ? err.message : 'Terjadi kesalahan.');
      }
    }
    if (wajibMasuk()) muat();
  </script>
</Aplikasi>

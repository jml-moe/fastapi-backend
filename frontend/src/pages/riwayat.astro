---
import Aplikasi from '../layouts/Aplikasi.astro';
import Keadaan from '../components/Keadaan.astro';
import Kartu from '../components/Kartu.astro';
---

<Aplikasi judul="Riwayat" sub="Rekomendasi yang pernah Anda minta.">
  <div class="halaman" id="halaman">
    <p class="pesan pesan--sukses" id="sukses" role="status" hidden></p>
    <p class="pesan pesan--galat" id="galat-aksi" role="alert" hidden></p>
    <Keadaan memuat="Memuat riwayat">
      <Fragment slot="galat-aksi"><button class="tombol tombol--sekunder" type="button" id="ulang">Coba lagi</button></Fragment>
      <Fragment slot="kosong">
        <p>Anda belum pernah meminta rekomendasi.</p>
        <div class="baris"><a class="tombol" href="/rekomendasi/">Pilih Teknologi</a></div>
      </Fragment>
    </Keadaan>

    <div data-keadaan="siap" hidden>
      <Kartu judul="Daftar rekomendasi" sub="Yang terbaru di atas." nol>
        <div class="gulir" role="region" aria-label="Tabel riwayat rekomendasi" tabindex="0">
          <table>
            <thead>
              <tr>
                <th scope="col">Tanggal</th>
                <th scope="col" class="angka">Teknologi</th>
                <th scope="col">Bidang teratas</th>
                <th scope="col" class="angka">Skor</th>
                <th scope="col"><span class="sr-saja">Aksi</span></th>
              </tr>
            </thead>
            <tbody id="daftar"></tbody>
          </table>
        </div>
      </Kartu>
    </div>
  </div>

  <script>
    import { api } from '../lib/api';
    import { konfirmasi } from '../lib/konfirmasi';
    import { wajibMasuk } from '../lib/auth';
    import { $, angka, el, tampilkan, tanggal } from '../lib/ui';
    import type { RingkasRiwayat } from '../lib/types';

    const halaman = $('#halaman');
    const sukses = $('#sukses');
    const galatAksi = $('#galat-aksi');

    async function hapus(r: RingkasRiwayat) {
      galatAksi.hidden = true;
      sukses.hidden = true;
      try {
        const lanjut = await konfirmasi({
          judul: 'Hapus rekomendasi ini?',
          pesan: `Rekomendasi tanggal ${tanggal(r.created_at)} dihapus permanen dari riwayat Anda dan tidak bisa dikembalikan.`,
          aksi: 'Hapus',
          bahaya: true,
        });
        if (!lanjut) return;
        await api(`/recommendations/${r.id}`, { method: 'DELETE' });
        sukses.textContent = 'Rekomendasi dihapus dari riwayat.';
        sukses.hidden = false;
        await muat();
      } catch (err) {
        galatAksi.textContent = err instanceof Error ? err.message : 'Terjadi kesalahan.';
        galatAksi.hidden = false;
      }
    }

    async function muat() {
      tampilkan(halaman, 'memuat');
      try {
        const data = await api<RingkasRiwayat[]>('/recommendations');
        if (data.length === 0) return tampilkan(halaman, 'kosong');
        $('#daftar').replaceChildren(
          ...data.map((r) => {
            const teratas = r.top[0];
            return el(
              'tr',
              {},
              el('td', {}, tanggal(r.created_at)),
              el('td', { class: 'angka' }, String(r.teknologi_dipilih.length)),
              el('td', {}, teratas?.bidang_karier ?? '-'),
              el('td', { class: 'angka' }, teratas ? angka(teratas.skor) : '-'),
              el(
                'td',
                { class: 'angka' },
                (() => {
                  const tombolHapus = el('button', { type: 'button', class: 'tombol tombol--hapus tombol--kecil' }, 'Hapus', el('span', { class: 'sr-saja' }, ` rekomendasi ${tanggal(r.created_at)}`));
                  tombolHapus.addEventListener('click', () => hapus(r));
                  return el('div', { class: 'baris baris--kanan' }, el('a', { href: `/hasil/?id=${r.id}` }, 'Buka hasil'), tombolHapus);
                })(),
              ),
            );
          }),
        );
        tampilkan(halaman, 'siap');
      } catch (err) {
        $('[data-pesan-galat]', halaman).textContent = err instanceof Error ? err.message : 'Terjadi kesalahan.';
        tampilkan(halaman, 'galat');
      }
    }

    $('#ulang').addEventListener('click', muat);
    if (wajibMasuk()) muat();
  </script>
</Aplikasi>

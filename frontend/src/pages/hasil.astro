---
import Base from '../layouts/Base.astro';
import Keadaan from '../components/Keadaan.astro';
---

<Base judul="Hasil rekomendasi">
  <div class="tumpukan" id="halaman">
    <Keadaan memuat="Memuat hasil">
      <a slot="galat-aksi" class="tombol tombol--sekunder" href="/riwayat/">Lihat riwayat</a>
      <Fragment slot="kosong"><p>Rekomendasi ini tidak memuat bidang apa pun.</p></Fragment>
    </Keadaan>

    <div data-keadaan="siap" class="tumpukan" hidden>
      <div class="tumpukan--rapat">
        <h1>Hasil rekomendasi</h1>
        <p class="sub" id="waktu"></p>
        <ul class="chips" id="dipilih" aria-label="Teknologi yang Anda pilih"></ul>
      </div>

      <section class="tumpukan" aria-labelledby="judul-top">
        <h2 class="judul-bagian" id="judul-top">Bidang yang paling mirip</h2>
        <ol class="peringkat-daftar" id="top"></ol>
      </section>

      <section class="tumpukan--rapat" aria-labelledby="judul-semua">
        <h2 class="judul-bagian" id="judul-semua">Peringkat semua bidang</h2>
        <div class="gulir" role="region" aria-label="Tabel peringkat semua bidang" tabindex="0">
          <table>
            <thead>
              <tr><th scope="col" class="angka">Peringkat</th><th scope="col">Bidang karier</th><th scope="col" class="angka">Skor</th></tr>
            </thead>
            <tbody id="semua"></tbody>
          </table>
        </div>
        <p class="kecil">
          Skor adalah cosine similarity antara pilihan Anda dan profil teknologi bidang tersebut, dari 0
          (tidak mirip) sampai 1 (sangat mirip). Skor tidak memprediksi peluang diterima kerja.
        </p>
      </section>

      <div class="aksi">
        <a class="tombol" href="/rekomendasi/">Pilih ulang teknologi</a>
        <a class="tombol tombol--sekunder" href="/riwayat/">Lihat riwayat</a>
      </div>
    </div>
  </div>

  <script>
    import { api } from '../lib/api';
    import { wajibMasuk } from '../lib/auth';
    import { $, angka, el, namaTeknologi, parameterUrl, persen, tampilkan, tanggal } from '../lib/ui';
    import type { Peringkat, Rekomendasi } from '../lib/types';

    const halaman = $('#halaman');

    function galat(teks: string) {
      $('[data-pesan-galat]', halaman).textContent = teks;
      tampilkan(halaman, 'galat');
    }

    function kartu(p: Peringkat, utama: boolean) {
      const sumbangan = el('ul', { class: 'daftar-bersih' });
      for (const s of (p.sumbangan ?? []).slice(0, 5)) {
        sumbangan.append(el('li', {}, el('span', {}, namaTeknologi(s.kode)), el('span', { class: 'skor' }, persen(s.sumbangan))));
      }
      const umum = el('ul', { class: 'chips' });
      for (const u of p.teknologi_umum ?? []) {
        umum.append(
          el(
            'li',
            { class: u.dipilih ? 'chip chip--pilih' : 'chip' },
            `${namaTeknologi(u.kode)} ${persen(u.proporsi)}`,
            u.dipilih ? ' (Anda pilih)' : '',
          ),
        );
      }
      const meter = el('meter', { min: '0', max: '1', value: String(p.skor), 'aria-label': `Skor kemiripan ${angka(p.skor)}` });
      meter.textContent = angka(p.skor);

      return el(
        'li',
        { class: utama ? 'kartu hasil hasil--utama' : 'kartu hasil' },
        el(
          'div',
          { class: 'hasil__kepala' },
          el('h3', {}, el('span', { class: 'nomor' }, `${p.peringkat}. `), p.bidang_karier),
          el('span', { class: 'skor' }, `Skor ${angka(p.skor)}`),
        ),
        meter,
        el(
          'div',
          { class: 'dua-kolom' },
          el('div', { class: 'tumpukan--rapat' }, el('h4', { class: 'label' }, 'Teknologi Anda yang paling berperan'), sumbangan),
          el('div', { class: 'tumpukan--rapat' }, el('h4', { class: 'label' }, 'Teknologi paling umum di bidang ini'), umum),
        ),
      );
    }

    async function muat() {
      const id = Number(parameterUrl('id'));
      if (!Number.isInteger(id) || id <= 0) return galat('Alamat ini tidak memuat nomor rekomendasi yang valid.');
      try {
        const r = await api<Rekomendasi>(`/recommendations/${id}`);
        if (r.peringkat.length === 0) return tampilkan(halaman, 'kosong');

        $('#waktu').textContent = `Dibuat ${tanggal(r.created_at)}`;
        $('#dipilih').replaceChildren(...r.teknologi_dipilih.map((k) => el('li', { class: 'chip' }, namaTeknologi(k))));
        const top = r.peringkat.filter((p) => p.sumbangan);
        $('#top').replaceChildren(...top.map((p, i) => kartu(p, i === 0)));
        $('#semua').replaceChildren(
          ...r.peringkat.map((p) =>
            el('tr', {}, el('td', { class: 'angka' }, String(p.peringkat)), el('td', {}, p.bidang_karier), el('td', { class: 'angka' }, angka(p.skor))),
          ),
        );
        tampilkan(halaman, 'siap');
      } catch (err) {
        galat(err instanceof Error ? err.message : 'Terjadi kesalahan.');
      }
    }
    if (wajibMasuk()) muat();
  </script>
</Base>

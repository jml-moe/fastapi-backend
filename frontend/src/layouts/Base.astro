---
import '../styles/global.css';

interface Props {
  judul: string;
  deskripsi?: string;
}

const { judul, deskripsi = 'Rekomendasi bidang karier developer dari teknologi yang sudah Anda kuasai.' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={deskripsi} />
    <link rel="icon" href="data:," />
    <title>{judul} | Rekomendasi Karier</title>
  </head>
  <body>
    <slot />
  </body>
</html>
